        <mxCell id="e9fRuYyZZuLOpj3REtJb-3" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;" value="EPOLICY DELIVERY CONSUMER.&lt;br&gt;&lt;br&gt;Changes :&lt;br&gt;Add Additional Header to SMTP/EWS as Key and Save to Database.&lt;br&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;Cascadia Mono&amp;quot;; font-size: 9pt; color: rgb(0, 0, 0);&quot;&gt; &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;message&lt;/span&gt;.Headers.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;Add&lt;/span&gt;(&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;Original-Message-ID&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;messageId&lt;/span&gt;.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;ToString&lt;/span&gt;());&lt;br&gt; &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;message&lt;/span&gt;.Headers.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;Add&lt;/span&gt;(&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;X-Correlation-ID&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;$&quot;SMTPDelivTrack|&lt;/span&gt;{&lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;messageId&lt;/span&gt;.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;ToString&lt;/span&gt;()}&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;&lt;/span&gt;);&lt;br&gt; &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;message&lt;/span&gt;.Headers.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;Add&lt;/span&gt;(&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;X-Sent-By&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;SMTPDelivTrack&quot;&lt;/span&gt;);&lt;br&gt; &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;message&lt;/span&gt;.Headers.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;Add&lt;/span&gt;(&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;X-Process-ID&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;SMTP Email Service &amp;amp; Delivery Tracking&quot;&lt;/span&gt;);&lt;br&gt; &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;message&lt;/span&gt;.Headers.&lt;span style=&quot;color: rgb(116, 83, 31);&quot;&gt;Add&lt;/span&gt;(&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;Return-Path&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;asri.setiawan@axa-mandiri.co.id&quot;&lt;/span&gt;);&lt;/pre&gt;&lt;/div&gt;&lt;br&gt;&lt;br&gt;add catch handler mark as failed&lt;pre style=&quot;font-family: &amp;quot;Cascadia Mono&amp;quot;; font-size: 9pt; color: rgb(0, 0, 0);&quot;&gt; &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;code&lt;/span&gt; == MailKit.Net.Smtp.&lt;span style=&quot;color: rgb(43, 145, 175);&quot;&gt;SmtpStatusCode&lt;/span&gt;.ServiceNotAvailable&lt;br&gt;        || &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;code&lt;/span&gt; == MailKit.Net.Smtp.&lt;span style=&quot;color: rgb(43, 145, 175);&quot;&gt;SmtpStatusCode&lt;/span&gt;.MailboxBusy&lt;br&gt;        || &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;code&lt;/span&gt; == MailKit.Net.Smtp.&lt;span style=&quot;color: rgb(43, 145, 175);&quot;&gt;SmtpStatusCode&lt;/span&gt;.ErrorInProcessing&lt;br&gt;        || &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;code&lt;/span&gt; == MailKit.Net.Smtp.&lt;span style=&quot;color: rgb(43, 145, 175);&quot;&gt;SmtpStatusCode&lt;/span&gt;.InsufficientStorage&lt;br&gt;        || &lt;span style=&quot;color: rgb(31, 55, 127);&quot;&gt;code&lt;/span&gt; == MailKit.Net.Smtp.&lt;span style=&quot;color: rgb(43, 145, 175);&quot;&gt;SmtpStatusCode&lt;/span&gt;.TransactionFailed;&lt;/pre&gt;&lt;br&gt;add catch handler mark as&amp;nbsp;&lt;pre style=&quot;font-family: &amp;quot;Cascadia Mono&amp;quot;; font-size: 9pt; color: rgb(0, 0, 0);&quot;&gt;MailboxUnavailable&lt;br&gt;&lt;br&gt;insert history&lt;/pre&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
